{
  "name": "global-stock-control-desktop",
  "version": "1.0.0",
  "description": "GLOBAL STOCK CONTROL - BISNIS HOTEL (aplikasi Windows)",
  "author": "BISNIS HOTEL",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "id.bisnishotel.stockcontrol",
    "productName": "Global Stock Control",
    "files": ["main.js", "out/**/*"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GlobalStockControl-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "GlobalStockControl-Portable-${version}.exe"
    }
  }
}
